{
  "name": "e-cidade/site",
  "description": "Site comunitário do ecossistema e-Cidade",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "samdark/sitemap": "^3.0",
    "tightenco/jigsaw": "^1.8.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Listeners\\": "listeners/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "dev": "npm run dev",
    "build": "npm run build",
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit --colors=always --fail-on-warning --fail-on-risky",
    "test:build": "bash scripts/test-build.sh"
  }
}
